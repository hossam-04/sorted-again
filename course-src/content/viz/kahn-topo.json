{
  "title": "Kahn's algorithm: take each course once it's ready",
  "function": "take_courses",
  "args": {"n": 6, "prereqs": [[2, 0], [2, 1], [3, 1], [4, 2], [4, 3], [5, 3]]},
  "inputs": [],
  "layout": [
    {"type": "graph", "options": {
      "name": "courses: an arrow leads from a prerequisite to a course that needs it; the number is how many prerequisites are still untaken",
      "nodes": [{"id": 0, "x": 6, "y": 8}, {"id": 1, "x": 6, "y": 40}, {"id": 2, "x": 32, "y": 8}, {"id": 3, "x": 32, "y": 40}, {"id": 4, "x": 58, "y": 24}, {"id": 5, "x": 58, "y": 56}],
      "edges": [{"a": 0, "b": 2, "directed": true}, {"a": 1, "b": 2, "directed": true}, {"a": 1, "b": 3, "directed": true}, {"a": 2, "b": 4, "directed": true}, {"a": 3, "b": 4, "directed": true}, {"a": 3, "b": 5, "directed": true}]
    }, "bind": {
      "dist": "{i: waiting[i] for i in range(n)} if 'waiting' in locals() else {}",
      "done": "order if 'order' in locals() else []",
      "frontier": "list(queue) if 'queue' in locals() else []",
      "current": "c if __line__ in (13, 14, 15, 16, 17, 18) else None",
      "edges_on": "[[c, nxt]] if __line__ in (16, 17, 18) else [[b, a]] if __line__ in (8, 9) else []"
    }},
    {"type": "queue", "options": {"name": "queue: ready to take"}, "bind": {"items": "list(queue) if 'queue' in locals() else []"}},
    {"type": "vars", "bind": {"order": "order if 'order' in locals() else []"}}
  ]
}
